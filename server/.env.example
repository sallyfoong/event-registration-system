# ===== Application =====
NODE_ENV=development
PORT=8000
LOG_LEVEL=info
# Comma separated list of allowed origins for CORS (the frontend runs on 8001)
CORS_ORIGIN=http://localhost:8001
# Set to true only when the API sits behind Nginx / a load balancer.
# Keep it false when the API is directly reachable: trusting X-Forwarded-For
# unconditionally lets a client pick its own IP and bypass rate limiting.
TRUST_PROXY=false

# ===== Database =====
# Dialect: mysql (default, production-like) or sqlite (local convenience)
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=event_registration
# These are the credentials README step 1 creates, and the same pair
# docker-compose.yml uses, so a copy of this file connects to either one
# without editing. Point them at your own account if you already run MySQL.
DB_USER=event_app
DB_PASSWORD=eventapp
# Only used when DB_DIALECT=sqlite
DB_STORAGE=./data/dev.sqlite
# Set to true to let Sequelize alter existing tables to match models on startup (dev only)
SYNC_ALTER=false

# ===== Paging =====
PAGE_SIZE=10

# ===== Read cache =====
# How long an in-process read cache may serve a response, in milliseconds.
# 0 disables it (the test suite runs with 0). Keep it short: with more than
# one API instance, a write only clears the cache of the instance that served
# it, so this value is what bounds staleness elsewhere.
CACHE_TTL_MS=10000

# ===== OneMap (Singapore postal code validation) =====
# Register a free account at https://www.onemap.gov.sg/apidocs/register
# Either set ONEMAP_TOKEN (an access token, valid for three days) or the
# account below - the token wins when both are present, because it needs no
# login round trip.
#
# Required for creating events. With all three blank the API refuses every
# create with a 500: the brief requires each postal code to be validated,
# and there is nothing here to validate it against.
ONEMAP_TOKEN=
ONEMAP_EMAIL=
ONEMAP_PASSWORD=
ONEMAP_BASE_URL=https://www.onemap.gov.sg
