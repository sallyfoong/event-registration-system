{
  "name": "event-registration-system",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "description": "Event Registration System - root convenience scripts (server + client monorepo).",
  "scripts": {
    "prepare": "husky",
    "install:all": "npm --prefix server install && npm --prefix client install",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "npm --prefix server run typecheck && npm --prefix client run typecheck && tsc -p e2e/tsconfig.json",
    "test": "npm --prefix server test",
    "seed": "npm --prefix server run seed",
    "dev:api": "npm --prefix server run dev",
    "dev:web": "npm --prefix client run dev",
    "build": "npm --prefix client run build && npm --prefix server run build",
    "test:e2e": "playwright test --config e2e/playwright.config.ts"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,json,md,yml,yaml,css,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.14.0",
    "@playwright/test": "^1.49.0",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "typescript-eslint": "^8.13.0"
  }
}
