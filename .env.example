# Copy to .env and edit. Never commit the real values.
#
# The defaults are the local development values. On a server, change the
# passwords - the .env file is read by docker compose and is in .gitignore.

# ===== Database =====
DB_NAME=event_registration
DB_USER=event_app
DB_PASSWORD=eventapp
# root password of the MySQL container itself
DB_ROOT_PASSWORD=rootpassword
# host port the database is published on, bound to 127.0.0.1
DB_PORT=3306

# ===== Application =====
# host ports, all bound to 127.0.0.1 - the reverse proxy is the only
# way in
API_PORT=8000
WEB_PORT=8081

# the site's own address. The browser loads the bundle from the same
# host that serves the API, so this is the only allowed origin.
CORS_ORIGIN=https://events.myminisite.work

LOG_LEVEL=info

# ===== OneMap (Singapore postal code validation) =====
# Either set ONEMAP_TOKEN (an access token, valid three days) or the account
# below - the token wins when both are present. Required: without it the API
# refuses to create events.
ONEMAP_TOKEN=
ONEMAP_EMAIL=
ONEMAP_PASSWORD=
ONEMAP_BASE_URL=https://www.onemap.gov.sg
