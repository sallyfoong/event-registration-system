# Event Registration System - reverse proxy site.
#
# One file per project on this server, so a change here cannot break
# another project's configuration. The root Caddyfile imports every file
# in /etc/caddy/sites.d/.
#
# What this file does:
#   - terminates TLS for the public hostname
#   - forwards everything to the nginx container, which serves the React
#     bundle and proxies /api/* to the API container
#
# The public hostname is substituted when the file is installed on the
# server (see deploy/README.md). Everything else here is environment
# independent.

# Cloudflare's published proxy ranges. Requests arriving from these
# addresses are proxied traffic, and Cloudflare hands the real client
# address over in CF-Connecting-IP.
#
# The list is published at https://www.cloudflare.com/ips-v4 - refresh it
# when Cloudflare announces a change, otherwise proxied clients fall back
# to the generic branch below and lose their real address.

# How the container stack is reached. The compose file binds these to
# 127.0.0.1, so nothing outside this machine can talk to them directly.

__DOMAIN__ {
	@cloudflare remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 \
		103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 \
		188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 \
		104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22

	# Proxied traffic: take the client address Cloudflare resolved and
	# put it in X-Forwarded-For.
	#
	# This has to be explicit. Caddy replaces any incoming
	# X-Forwarded-For with the address it sees, so without this header
	# every visitor would arrive as the Cloudflare edge node and the
	# API's per-IP rate limiter would treat them all as one client.
	reverse_proxy @cloudflare 127.0.0.1:8081 {
		header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		header_up X-Real-IP {http.request.header.CF-Connecting-IP}
	}

	# Direct traffic (origin IP, health checks): keep the address Caddy
	# observed. This branch is the fallback, not the expected path.
	reverse_proxy 127.0.0.1:8081

	encode gzip
}
